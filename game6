<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>小鸭子骑车</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{
    height:100%;
    overflow:hidden;
    background:#101820;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:"PingFang SC","Microsoft YaHei",system-ui,sans-serif;
    -webkit-tap-highlight-color:transparent;
    user-select:none;
    -webkit-user-select:none;
  }
  #cv{
    display:block;
    width:min(100vw, calc(100vh * 16 / 9));
    height:min(100vh, calc(100vw * 9 / 16));
    touch-action:none;
    cursor:pointer;
    background:#8fd3f4;
  }
</style>
</head>
<body>
<canvas id="cv"></canvas>
<script>
(function(){
  'use strict';

  /* ========== 基础设置 ========== */
  const cv = document.getElementById('cv');
  const ctx = cv.getContext('2d');

  const W = 960, H = 540;          // 逻辑尺寸
  const SCALE = 2;                 // 高清渲染倍率
  cv.width = W * SCALE;
  cv.height = H * SCALE;

  const GROUND_Y = 430;            // 地面线
  const PX = 220;                  // 小鸭子固定的屏幕横坐标
  const GRAVITY = 2000;            // 重力
  const JUMP_V = 880;              // 起跳初速度

  /* ========== 游戏状态 ========== */
  const state = {
    mode: 'ready',        // ready | playing | over
    t: 0,
    dist: 0,              // 世界滚动距离
    startDist: 0,
    speed: 380,
    score: 0,
    best: 0,
    obstacles: [],
    nextSpawn: 700,
    jumpBuffer: 0,
    shake: 0,
    particles: [],
    overAt: 0,
    player: { y: 0, vy: 0, onGround: true }
  };

  // 云朵
  const clouds = [];
  for (let i = 0; i < 7; i++) {
    clouds.push({
      x: Math.random() * (W + 700),
      y: 40 + Math.random() * 170,
      s: 0.6 + Math.random() * 0.9
    });
  }

  /* ========== 工具函数 ========== */
  function line(x1, y1, x2, y2) {
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
  }

  function roundRect(x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  /* ========== 开始 / 结束 ========== */
  function startGame() {
    state.mode = 'playing';
    state.score = 0;
    state.speed = 380;
    state.startDist = state.dist;
    state.obstacles.length = 0;
    state.particles.length = 0;
    state.nextSpawn = state.dist + 700;
    state.jumpBuffer = 0;
    state.shake = 0;
    state.player.y = 0;
    state.player.vy = 0;
    state.player.onGround = true;
  }

  function gameOver() {
    state.mode = 'over';
    state.overAt = state.t;
    state.shake = 18;
    state.best = Math.max(state.best, state.score);
    spawnBurst(PX, GROUND_Y - state.player.y - 50);
    // 撞到后被弹起来一下
    state.player.vy = 320;
    state.player.onGround = false;
  }

  /* ========== 粒子 ========== */
  function spawnDust() {
    for (let i = 0; i < 8; i++) {
      const a = Math.PI + Math.random() * Math.PI;
      const s = 40 + Math.random() * 120;
      state.particles.push({
        x: PX - 20 + Math.random() * 40,
        y: GROUND_Y - 4,
        vx: Math.cos(a) * s,
        vy: -Math.random() * 120,
        r: 2 + Math.random() * 3,
        life: 0.35 + Math.random() * 0.3,
        max: 0.65,
        color: 'rgba(255,255,255,0.85)'
      });
    }
  }

  function spawnBurst(x, y) {
    const colors = ['#FFD93B', '#FF9F1C', '#E8453C', '#ffffff', '#c2c8d1'];
    for (let i = 0; i < 26; i++) {
      const a = Math.random() * Math.PI * 2;
      const s = 80 + Math.random() * 300;
      state.particles.push({
        x: x,
        y: y,
        vx: Math.cos(a) * s,
        vy: Math.sin(a) * s - 120,
        r: 2 + Math.random() * 4,
        life: 0.6 + Math.random() * 0.5,
        max: 1.1,
        color: colors[(Math.random() * colors.length) | 0]
      });
    }
  }

  function updateParticles(dt) {
    for (let i = state.particles.length - 1; i >= 0; i--) {
      const p = state.particles[i];
      p.vy += 1500 * dt;
      p.x += p.vx * dt;
      p.y += p.vy * dt;
      p.life -= dt;
      if (p.life <= 0) state.particles.splice(i, 1);
    }
  }

  /* ========== 障碍物（石头） ========== */
  function spawnObstacle() {
    const diff = Math.min(state.score / 120, 1);
    const w = 40 + Math.random() * (24 + diff * 14);
    const h = 28 + Math.random() * (14 + diff * 8);

    const pts = [];
    const n = 7;
    pts.push([-w / 2, 0]);
    for (let i = 0; i <= n; i++) {
      const t = i / n;
      const x = -w / 2 + w * t;
      const bump = Math.sin(Math.PI * t);
      const y = -h * (0.38 + 0.62 * bump) * (0.85 + Math.random() * 0.28);
      pts.push([x, y]);
    }
    pts.push([w / 2, 0]);

    state.obstacles.push({
      worldX: state.dist + W + 80,
      w: w,
      h: h,
      pts: pts
    });
  }

  /* ========== 更新逻辑 ========== */
  function update(dt) {
    state.t += dt;

    const playing = state.mode === 'playing';

    // 待机时背景缓慢滚动
    if (state.mode === 'ready') {
      state.dist += 120 * dt;
    }

    if (playing) {
      state.speed = 380 + Math.min(state.score * 2.2, 260);
      state.dist += state.speed * dt;
      state.score = Math.floor((state.dist - state.startDist) / 40);

      // 生成障碍物
      if (state.dist > state.nextSpawn) {
        spawnObstacle();
        const gap = state.speed * (1.15 + Math.random() * 0.8);
        state.nextSpawn = state.dist + gap;
      }
    }

    // ---- 玩家物理 ----
    const p = state.player;
    if (!p.onGround) {
      p.vy -= GRAVITY * dt;
      p.y += p.vy * dt;
      if (p.y <= 0) {
        p.y = 0;
        p.vy = 0;
        p.onGround = true;
      }
    }

    // 跳跃缓冲（落地瞬间也能响应点击）
    if (state.jumpBuffer > 0) {
      state.jumpBuffer -= dt;
      if (playing && p.onGround) {
        p.vy = JUMP_V;
        p.onGround = false;
        state.jumpBuffer = 0;
        spawnDust();
      }
    }

    // ---- 障碍物清理 ----
    for (let i = state.obstacles.length - 1; i >= 0; i--) {
      if (state.obstacles[i].worldX - state.dist < -180) {
        state.obstacles.splice(i, 1);
      }
    }

    // ---- 碰撞检测 ----
    if (playing) {
      const pBottom = GROUND_Y - p.y;
      const pTop = pBottom - 96;
      const pLeft = PX - 46;
      const pRight = PX + 42;

      for (let i = 0; i < state.obstacles.length; i++) {
        const o = state.obstacles[i];
        const ox = o.worldX - state.dist;
        const oLeft = ox - (o.w / 2) * 0.86;
        const oRight = ox + (o.w / 2) * 0.86;
        const oTop = GROUND_Y - o.h * 0.9;
        const oBottom = GROUND_Y;

        if (pRight > oLeft && pLeft < oRight && pBottom > oTop && pTop < oBottom) {
          gameOver();
          break;
        }
      }
    }

    // ---- 粒子 & 震动 ----
    updateParticles(dt);
    if (state.shake > 0) {
      state.shake = Math.max(0, state.shake - 60 * dt);
    }
  }

  /* ========== 绘制：背景 ========== */
  function drawSky() {
    const g = ctx.createLinearGradient(0, 0, 0, GROUND_Y);
    g.addColorStop(0, '#6fc9f0');
    g.addColorStop(0.55, '#a8e2f7');
    g.addColorStop(1, '#dcf3ff');
    ctx.fillStyle = g;
    ctx.fillRect(-40, -40, W + 80, GROUND_Y + 60);

    // 太阳
    ctx.save();
    const sg = ctx.createRadialGradient(820, 92, 8, 820, 92, 90);
    sg.addColorStop(0, 'rgba(255,246,190,0.95)');
    sg.addColorStop(0.45, 'rgba(255,238,150,0.32)');
    sg.addColorStop(1, 'rgba(255,238,150,0)');
    ctx.fillStyle = sg;
    ctx.beginPath();
    ctx.arc(820, 92, 90, 0, Math.PI * 2);
    ctx.fill();

    ctx.beginPath();
    ctx.arc(820, 92, 38, 0, Math.PI * 2);
    ctx.fillStyle = '#FFF5B0';
    ctx.fill();
    ctx.restore();
  }

  function drawClouds() {
    const total = W + 700;
    for (let i = 0; i < clouds.length; i++) {
      const c = clouds[i];
      const x = ((c.x - state.dist * 0.12) % total + total) % total - 350;
      ctx.save();
      ctx.translate(x, c.y);
      ctx.scale(c.s, c.s);
      ctx.fillStyle = 'rgba(255,255,255,0.92)';
      const puffs = [[0, 0, 26], [30, 6, 20], [-30, 8, 18], [6, -13, 20]];
      ctx.beginPath();
      for (let k = 0; k < puffs.length; k++) {
        const dx = puffs[k][0], dy = puffs[k][1], r = puffs[k][2];
        ctx.moveTo(dx + r, dy);
        ctx.arc(dx, dy, r, 0, Math.PI * 2);
      }
      ctx.fill();
      ctx.restore();
    }
  }

  function drawHills() {
    // 远山
    const period = 520;
    const off = (state.dist * 0.22) % period;
    ctx.fillStyle = '#a9dcb0';
    for (let i = -1; i < W / period + 2; i++) {
      const x = i * period - off;
      ctx.beginPath();
      ctx.moveTo(x - 60, GROUND_Y + 12);
      ctx.quadraticCurveTo(x + period * 0.5, GROUND_Y - 200, x + period + 60, GROUND_Y + 12);
      ctx.closePath();
      ctx.fill();
    }
    // 近山
    const period2 = 380;
    const off2 = (state.dist * 0.45) % period2;
    ctx.fillStyle = '#8ccf96';
    for (let i = -1; i < W / period2 + 2; i++) {
      const x = i * period2 - off2;
      ctx.beginPath();
      ctx.moveTo(x - 40, GROUND_Y + 12);
      ctx.quadraticCurveTo(x + period2 * 0.5, GROUND_Y - 125, x + period2 + 40, GROUND_Y + 12);
      ctx.closePath();
      ctx.fill();
    }
  }

  function drawGround() {
    // 草地
    const g = ctx.createLinearGradient(0, GROUND_Y, 0, GROUND_Y + 26);
    g.addColorStop(0, '#7ed07a');
    g.addColorStop(1, '#4fae59');
    ctx.fillStyle = g;
    ctx.fillRect(-40, GROUND_Y, W + 80, 26);

    // 泥土
    const g2 = ctx.createLinearGradient(0, GROUND_Y + 26, 0, H + 40);
    g2.addColorStop(0, '#c79a5c');
    g2.addColorStop(1, '#966c3c');
    ctx.fillStyle = g2;
    ctx.fillRect(-40, GROUND_Y + 26, W + 80, H - GROUND_Y + 60);

    ctx.fillStyle = 'rgba(0,0,0,0.13)';
    ctx.fillRect(-40, GROUND_Y + 24, W + 80, 4);

    // 滚动的地面纹理
    const off = state.dist % 120;
    ctx.fillStyle = 'rgba(120,85,45,0.32)';
    for (let x = -off - 120; x < W + 120; x += 120) {
      ctx.beginPath();
      ctx.ellipse(x + 30, GROUND_Y + 72, 10, 5, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.ellipse(x + 80, GROUND_Y + 46, 7, 4, 0, 0, Math.PI * 2);
      ctx.fill();
    }

    // 草叶
    const off2 = state.dist % 90;
    ctx.strokeStyle = 'rgba(255,255,255,0.35)';
    ctx.lineWidth = 2;
    for (let x = -off2 - 90; x < W + 90; x += 90) {
      ctx.beginPath();
      ctx.moveTo(x + 20, GROUND_Y + 6);
      ctx.lineTo(x + 24, GROUND_Y - 6);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x + 26, GROUND_Y + 8);
      ctx.lineTo(x + 32, GROUND_Y - 2);
      ctx.stroke();
    }
  }

  /* ========== 绘制：石头 ========== */
  function drawRock(x, gy, w, h, pts) {
    ctx.save();
    ctx.translate(x, gy);

    // 影子
    ctx.beginPath();
    ctx.ellipse(0, 0, w * 0.66, 8, 0, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(0,0,0,0.18)';
    ctx.fill();

    // 石头本体
    ctx.beginPath();
    ctx.moveTo(pts[0][0], pts[0][1]);
    for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i][0], pts[i][1]);
    ctx.closePath();

    const g = ctx.createLinearGradient(0, -h, 0, 0);
    g.addColorStop(0, '#c9cfd8');
    g.addColorStop(0.5, '#98a0ac');
    g.addColorStop(1, '#6d7683');
    ctx.fillStyle = g;
    ctx.fill();
    ctx.lineWidth = 2.5;
    ctx.strokeStyle = '#5a626e';
    ctx.stroke();

    // 高光
    ctx.beginPath();
    ctx.ellipse(-w * 0.16, -h * 0.6, w * 0.15, h * 0.17, -0.5, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(255,255,255,0.38)';
    ctx.fill();

    // 裂纹
    ctx.beginPath();
    ctx.moveTo(w * 0.05, -h * 0.55);
    ctx.lineTo(w * 0.18, -h * 0.35);
    ctx.lineTo(w * 0.1, -h * 0.16);
    ctx.strokeStyle = 'rgba(90,98,110,0.7)';
    ctx.lineWidth = 1.6;
    ctx.stroke();

    ctx.restore();
  }

  function drawObstacles() {
    for (let i = 0; i < state.obstacles.length; i++) {
      const o = state.obstacles[i];
      const x = o.worldX - state.dist;
      if (x < -140 || x > W + 220) continue;
      drawRock(x, GROUND_Y, o.w, o.h, o.pts);
    }
  }

  /* ========== 绘制：小鸭子 + 自行车 ========== */
  function drawWheel(cx, cy, r, spin) {
    ctx.save();
    ctx.translate(cx, cy);

    // 轮胎
    ctx.beginPath();
    ctx.arc(0, 0, r - 3, 0, Math.PI * 2);
    ctx.strokeStyle = '#2f333b';
    ctx.lineWidth = 6;
    ctx.stroke();

    // 轮圈
    ctx.beginPath();
    ctx.arc(0, 0, r - 7.5, 0, Math.PI * 2);
    ctx.strokeStyle = '#e2e8f0';
    ctx.lineWidth = 2.5;
    ctx.stroke();

    // 辐条
    ctx.rotate(spin);
    ctx.strokeStyle = 'rgba(255,255,255,0.9)';
    ctx.lineWidth = 1.6;
    for (let i = 0; i < 6; i++) {
      const a = i * Math.PI / 3;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(Math.cos(a) * (r - 8), Math.sin(a) * (r - 8));
      ctx.stroke();
    }

    // 花鼓
    ctx.beginPath();
    ctx.arc(0, 0, 3.5, 0, Math.PI * 2);
    ctx.fillStyle = '#8d949e';
    ctx.fill();

    ctx.restore();
  }

  function drawPlayer() {
    const p = state.player;
    const px = PX;
    const py = GROUND_Y - p.y;

    // 地面投影
    const t = Math.max(0, 1 - p.y / 260);
    ctx.save();
    ctx.globalAlpha = 0.05 + 0.2 * t;
    ctx.fillStyle = '#000';
    ctx.beginPath();
    ctx.ellipse(px, GROUND_Y - 2, 52 * (0.62 + 0.38 * t), 8 * (0.62 + 0.38 * t), 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();

    ctx.save();
    ctx.translate(px, py);

    const R = 22;
    const spin = state.dist / R;
    const crank = state.dist / 26;

    const rearX = -34, frontX = 34, hubY = -R;
    const bb = { x: -2, y: -26 };
    const seatTop = { x: -28, y: -74 };
    const headTop = { x: 30, y: -72 };
    const headBot = { x: 33, y: -32 };

    // ---- 车轮 ----
    drawWheel(rearX, hubY, R, spin);
    drawWheel(frontX, hubY, R, spin);

    // ---- 车架 ----
    ctx.lineCap = 'round';
    ctx.strokeStyle = '#E8453C';
    ctx.lineWidth = 7;
    line(rearX, hubY, bb.x, bb.y);                 // 后下叉
    line(rearX, hubY, seatTop.x, seatTop.y);       // 后上叉
    line(seatTop.x, seatTop.y, bb.x, bb.y);        // 座管
    line(bb.x, bb.y, headBot.x, headBot.y);        // 下管
    line(seatTop.x, seatTop.y, headTop.x, headTop.y); // 上管

    // 前叉
    ctx.strokeStyle = '#c9ccd3';
    ctx.lineWidth = 6;
    line(headBot.x, headBot.y, frontX, hubY);
    line(headTop.x, headTop.y, headBot.x, headBot.y);

    // 车把
    ctx.strokeStyle = '#3a3f47';
    ctx.lineWidth = 5;
    ctx.beginPath();
    ctx.moveTo(headTop.x - 8, headTop.y - 2);
    ctx.quadraticCurveTo(headTop.x + 6, headTop.y - 14, headTop.x + 16, headTop.y - 2);
    ctx.stroke();

    // 车座
    ctx.fillStyle = '#3a3f47';
    ctx.beginPath();
    ctx.ellipse(seatTop.x - 3, seatTop.y - 2, 14, 6.5, -0.12, 0, Math.PI * 2);
    ctx.fill();

    // 牙盘
    ctx.beginPath();
    ctx.arc(bb.x, bb.y, 9, 0, Math.PI * 2);
    ctx.fillStyle = '#cfd4db';
    ctx.fill();
    ctx.strokeStyle = '#9aa1ab';
    ctx.lineWidth = 2;
    ctx.stroke();

    // 曲柄 + 踏板位置
    const cr = 13;
    const p1 = { x: bb.x + Math.cos(crank) * cr, y: bb.y + Math.sin(crank) * cr };
    const p2 = { x: bb.x - Math.cos(crank) * cr, y: bb.y - Math.sin(crank) * cr };

    ctx.strokeStyle = '#8d949e';
    ctx.lineWidth = 4;
    line(bb.x, bb.y, p1.x, p1.y);
    line(bb.x, bb.y, p2.x, p2.y);

    // ---- 小鸭子的腿（踩踏板）----
    ctx.strokeStyle = '#F29A2E';
    ctx.lineWidth = 6;
    ctx.lineCap = 'round';
    line(-11, -76, p2.x, p2.y);
    line(-1, -76, p1.x, p1.y);

    // 踏板
    ctx.fillStyle = '#3a3f47';
    ctx.beginPath(); ctx.ellipse(p1.x, p1.y, 7, 3.5, 0, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(p2.x, p2.y, 7, 3.5, 0, 0, Math.PI * 2); ctx.fill();

    // ---- 小鸭子 ----
    const bodyX = -8, bodyY = -96;

    // 尾巴
    ctx.fillStyle = '#FFD93B';
    ctx.beginPath();
    ctx.moveTo(bodyX - 16, bodyY - 6);
    ctx.quadraticCurveTo(bodyX - 42, bodyY - 20, bodyX - 30, bodyY + 8);
    ctx.closePath();
    ctx.fill();

    // 身体
    ctx.beginPath();
    ctx.ellipse(bodyX, bodyY, 25, 22, -0.08, 0, Math.PI * 2);
    ctx.fillStyle = '#FFD93B';
    ctx.fill();
    ctx.strokeStyle = '#E8A800';
    ctx.lineWidth = 2;
    ctx.stroke();

    // 翅膀
    ctx.beginPath();
    ctx.ellipse(bodyX + 3, bodyY - 2, 14, 10, -0.35, 0, Math.PI * 2);
    ctx.fillStyle = '#F7C500';
    ctx.fill();
    ctx.strokeStyle = '#E8A800';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // 脖子
    ctx.strokeStyle = '#FFD93B';
    ctx.lineWidth = 22;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(0, -108);
    ctx.lineTo(20, -126);
    ctx.stroke();

    // 头
    ctx.beginPath();
    ctx.arc(24, -130, 16, 0, Math.PI * 2);
    ctx.fillStyle = '#FFD93B';
    ctx.fill();
    ctx.strokeStyle = '#E8A800';
    ctx.lineWidth = 2;
    ctx.stroke();

    // 鸭嘴
    ctx.beginPath();
    ctx.moveTo(36, -135);
    ctx.quadraticCurveTo(57, -133, 55, -126);
    ctx.quadraticCurveTo(48, -120, 36, -122);
    ctx.closePath();
    ctx.fillStyle = '#FF9F1C';
    ctx.fill();
    ctx.strokeStyle = '#E07B00';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // 眼睛
    ctx.beginPath();
    ctx.arc(29, -136, 3.2, 0, Math.PI * 2);
    ctx.fillStyle = '#2b2b2b';
    ctx.fill();
    ctx.beginPath();
    ctx.arc(30, -137.2, 1.1, 0, Math.PI * 2);
    ctx.fillStyle = '#ffffff';
    ctx.fill();

    ctx.restore();
  }

  /* ========== 绘制：粒子 ========== */
  function drawParticles() {
    for (let i = 0; i < state.particles.length; i++) {
      const p = state.particles[i];
      const a = Math.max(0, p.life / p.max);
      ctx.globalAlpha = a;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = p.color;
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  /* ========== 绘制：UI ========== */
  const FONT = '"PingFang SC","Microsoft YaHei",system-ui,sans-serif';

  function drawHUD() {
    ctx.save();
    ctx.textBaseline = 'middle';

    // 分数
    roundRect(24, 22, 210, 56, 18);
    ctx.fillStyle = 'rgba(20,40,60,0.32)';
    ctx.fill();
    ctx.textAlign = 'left';
    ctx.font = 'bold 28px ' + FONT;
    ctx.fillStyle = '#ffffff';
    ctx.fillText('分数 ' + state.score, 48, 51);

    // 最高分
    roundRect(W - 234, 22, 210, 56, 18);
    ctx.fillStyle = 'rgba(20,40,60,0.32)';
    ctx.fill();
    ctx.textAlign = 'right';
    ctx.fillStyle = '#FFF2B8';
    ctx.fillText('最高 ' + state.best, W - 48, 51);

    ctx.restore();
  }

  function drawReady() {
    ctx.save();
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

    // 标题
    ctx.font = 'bold 62px ' + FONT;
    ctx.lineWidth = 10;
    ctx.lineJoin = 'round';
    ctx.strokeStyle = '#2a4a66';
    ctx.strokeText('小鸭子骑车', W / 2, 150);
    ctx.fillStyle = '#FFE066';
    ctx.fillText('小鸭子骑车', W / 2, 150);

    // 提示（呼吸缩放）
    const pulse = 1 + Math.sin(state.t * 4) * 0.045;
    ctx.save();
    ctx.translate(W / 2, 250);
    ctx.scale(pulse, pulse);
    ctx.font = 'bold 32px ' + FONT;
    ctx.lineWidth = 8;
    ctx.strokeStyle = 'rgba(30,60,90,0.85)';
    ctx.strokeText('点击屏幕 让鸭子跳起来！', 0, 0);
    ctx.fillStyle = '#ffffff';
    ctx.fillText('点击屏幕 让鸭子跳起来！', 0, 0);
    ctx.restore();

    ctx.restore();
  }

  function drawOver() {
    ctx.save();

    ctx.fillStyle = 'rgba(10,25,40,0.5)';
    ctx.fillRect(0, 0, W, H);

    const pw = 540, ph = 320;
    const px = (W - pw) / 2;
    const py = (H - ph) / 2 - 10;

    roundRect(px, py, pw, ph, 30);
    ctx.fillStyle = 'rgba(255,255,255,0.97)';
    ctx.fill();
    ctx.lineWidth = 6;
    ctx.strokeStyle = '#FFD93B';
    ctx.stroke();

    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

    ctx.font = 'bold 42px ' + FONT;
    ctx.fillStyle = '#2a4a66';
    ctx.fillText('哎呀，撞到石头啦！', W / 2, py + 78);

    ctx.font = 'bold 38px ' + FONT;
    ctx.fillStyle = '#E8453C';
    ctx.fillText('本次得分  ' + state.score, W / 2, py + 150);

    ctx.font = 'bold 26px ' + FONT;
    ctx.fillStyle = '#7c8b9c';
    ctx.fillText('最高分  ' + state.best, W / 2, py + 202);

    const pulse = 1 + Math.sin(state.t * 5) * 0.05;
    ctx.save();
    ctx.translate(W / 2, py + 262);
    ctx.scale(pulse, pulse);
    ctx.font = 'bold 30px ' + FONT;
    ctx.fillStyle = '#2a8ef0';
    ctx.fillText('点击屏幕 再来一次', 0, 0);
    ctx.restore();

    ctx.restore();
  }

  /* ========== 渲染主函数 ========== */
  function render() {
    ctx.setTransform(SCALE, 0, 0, SCALE, 0, 0);
    ctx.clearRect(0, 0, W, H);

    // 基础天空铺满
    const bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, '#6fc9f0');
    bg.addColorStop(0.8, '#dcf3ff');
    bg.addColorStop(1, '#e8f4d8');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);

    ctx.save();
    if (state.shake > 0.5) {
      ctx.translate((Math.random() - 0.5) * state.shake,
                    (Math.random() - 0.5) * state.shake);
    }

    drawSky();
    drawClouds();
    drawHills();
    drawGround();
    drawObstacles();
    drawPlayer();
    drawParticles();

    ctx.restore();

    drawHUD();
    if (state.mode === 'ready') drawReady();
    if (state.mode === 'over') drawOver();
  }

  /* ========== 输入 ========== */
  function onPress(e) {
    if (e) e.preventDefault();

    if (state.mode === 'ready') {
      startGame();
    } else if (state.mode === 'playing') {
      state.jumpBuffer = 0.15;
    } else if (state.mode === 'over') {
      if (state.t - state.overAt > 0.55) startGame();
    }
  }

  window.addEventListener('pointerdown', onPress, { passive: false });
  window.addEventListener('contextmenu', function (e) { e.preventDefault(); });
  window.addEventListener('keydown', function (e) {
    if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW' || e.code === 'Enter') {
      e.preventDefault();
      onPress();
    }
  });

  /* ========== 主循环 ========== */
  let lastTime = performance.now();

  function loop(now) {
    let dt = (now - lastTime) / 1000;
    lastTime = now;
    if (dt > 0.05) dt = 0.05;   // 防止切后台后跳帧
    if (dt < 0) dt = 0;

    update(dt);
    render();

    requestAnimationFrame(loop);
  }

  requestAnimationFrame(loop);
})();
</script>
</body>
</html>
